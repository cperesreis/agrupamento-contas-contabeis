DB2_USER=seu_usuario
DB2_PASSWORD=sua_senha
DB2_HOST=servidor-db2.exemplo.local
DB2_PORT=50000
DB2_DATABASE=nome_do_banco

# Alternativa: use uma URL SQLAlchemy pronta e ignore as variáveis acima.
# DB2_SQLALCHEMY_URL=ibm_db_sa://usuario:senha@host:50000/database

AUTHENTIK_CLIENT_ID=seu_client_id_do_authentik
AUTHENTIK_CLIENT_SECRET=seu_client_secret_do_authentik
AUTHENTIK_REDIRECT_URI=http://localhost:8501/oauth2callback
AUTHENTIK_COOKIE_SECRET=um_segredo_aleatorio_longo_para_cookie
AUTHENTIK_SERVER_METADATA_URL=https://seu-authentik.local/application/o/slug-app/.well-known/openid-configuration
REQUEST_TIMEOUT_SECONDS=15
